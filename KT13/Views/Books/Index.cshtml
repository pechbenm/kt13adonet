@model IEnumerable<Book>
@{ ViewData["Title"] = "Книги"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Книги</h1>
    <a class="btn btn-primary" asp-action="Create">Добавить книгу</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Книг пока нет. Добавьте первую.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Название</th><th>Автор</th><th>Год</th><th>Жанр</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.Title</td>
                <td><a asp-controller="Authors" asp-action="Details" asp-route-id="@b.AuthorId">@b.Author?.FullName</a></td>
                <td>@b.PublishedYear</td>
                <td>@b.Genre</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.Id">Изменить</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@b.Id">Удалить</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
