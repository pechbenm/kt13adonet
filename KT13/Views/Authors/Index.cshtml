@model IEnumerable<Author>
@{ ViewData["Title"] = "Авторы"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Авторы</h1>
    <a class="btn btn-primary" asp-action="Create">Добавить автора</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Авторов пока нет. Добавьте первого.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Автор</th><th>Дата рождения</th><th>Книг</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.FullName</td>
                <td>@(a.BirthDate?.ToString("dd.MM.yyyy"))</td>
                <td>@a.Books.Count</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@a.Id">Открыть</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@a.Id">Изменить</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@a.Id">Удалить</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
